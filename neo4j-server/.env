#network
NETWORK_NAME=host
MYSQL_NETWORK_NAME=cts_network
NETWORK_DRIVER=host
NETWORK_EXTERNAL=true

#cluster
CLUSTER_MODE=CORE
CLUSTER_MEMBERS=10.40.40.59:5000,10.40.40.58:5000
CLUSTER_SIZE=2
CLUSTER_TYPE=LIST
