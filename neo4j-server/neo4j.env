#neo4j-server
NEO4J_ACCEPT_LICENSE_AGREEMENT="yes"
NEO4J_AUTH=neo4j/admin
NEO4J_dbms_default__database=neo4j
NEO4J_dbms_db_timezone=SYSTEM
NEO4J_dbms_directories_import="/import"

#memory
NEO4J_dbms_memory_heap_initial__size=10G
NEO4J_dbms_memory_heap_max__size=10G
NEO4J_dbms_memory_pagecache_size=35G
NEO4J_dbms_memory_transaction_database__max__size=2G
NEO4J_dbms_memory_transaction_max__size=2G
NEO4J_dbms_memory_off__heap_max__size=5G
NEO4J_dbms_jvm_additional="-XX:+ExitOnOutOfMemoryError"

#cypher
NEO4J_cypher_forbid__shortestpath__common__nodes="true"
NEO4J_cypher_forbid__exhaustive__shortestpath="true"

#monitoring
NEO4J_dbms_logs_debug_level=INFO
NEO4J_metrics_csv_enabled="false"
NEO4J_metrics_prometheus_enabled="true"
NEO4J_metrics_prometheus_endpoint="0.0.0.0:2004"

#security
NEO$J_dbms_security_auth__enabled=true

#locking
NEO4J_dbms_logs_query_time__logging__enabled="true"
NEO4J_dbms_lock_acquisition_timeout=1m
NEO4J_dbms_transaction_timeout=0s

#error handling
#NEO4J_errors_tolerance="all"
#NEO4J_errors_log_enable="true"
#NEO4J_errors_log_include_messages="true"

#Upgrade-neo4j
#NEO4J_dbms_allow__upgrade=true

#Apache Log4j Security Vulnerability
NEO4J_dbms_jvm_additional=-Dlog4j2.formatMsgNoLookups=true
NEO4J_dbms_logs_default__format=JSON
NEO4J_dbms_logs_http_enabled=false

#Install plugins
#NEO4JLABS_PLUGINS='["graph-data-science"]'
NEO4J_dbms_security_procedures_unrestricted=apoc.*,gds.*
